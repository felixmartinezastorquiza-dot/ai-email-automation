# Copy this file to .env and fill in your own values. Never commit .env.

LOG_LEVEL=INFO

# Chat model: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
CHAT_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here   # only if LLM_PROVIDER=openai (CHAT_MODEL=gpt-4o-mini)

# Postgres (Neon or Supabase free tier)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Author signature in the page footer
AUTHOR_NAME=Felix Martinez
AUTHOR_TITLE=Python & AI Integration Developer
